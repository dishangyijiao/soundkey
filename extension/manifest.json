{
  "manifest_version": 3,
  "name": "Soundkey",
  "version": "0.2.0",
  "description": "摘下一句，朗读，看哪个音没读准。",
  "permissions": ["sidePanel", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:17321/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Soundkey"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["sentence.js", "content.js"]
    }
  ]
}
